# Python cache and temporary files
__pycache__/
*.py[cod]
*$py.class
*.env

# Local sensitive configuration (protects Gemini API key from public exposure)
data/config.json

# SQLite temporary journal/write-ahead logs
data/*.db-journal
data/*.db-wal
data/*.db-shm

# Operating system files
.DS_Store
Thumbs.db
desktop.ini

# Match screenshot captures
Desktop/
Matches/
*.png
*.jpg
*.jpeg
